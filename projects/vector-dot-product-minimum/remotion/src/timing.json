   "lines": [
    {
     "id": "t1",
     "sub": "第四种  用三角函数直接算",
     "start": 149.469,
     "end": 152.11
    },
    {
     "id": "t2",
     "sub": "设 ∠DAC 为 θ",
     "start": 152.27,
     "end": 154.696
    },
    {
     "id": "t3",
     "sub": "由正弦定理  AD = 4 sin(60° − θ)",
     "start": 154.856,
     "end": 159.543
    },
    {
     "id": "t4",
     "sub": "点积 = −8 sin θ · sin(60° − θ)",
     "start": 160.043,
     "end": 164.877
    },
    {
     "id": "t5",
     "sub": "积化和差  = 2 − 4 cos(2θ − 60°)",
     "start": 165.037,
     "end": 169.781
    },
    {
     "id": "t6",
     "sub": "余弦最大是 1  所以结果不小于 −2",
     "start": 169.941,
     "end": 172.841
    },
    {
     "id": "t7",
     "sub": "θ = 30° 时取等号",
     "start": 173.001,
     "end": 175.371
    }
   ],
