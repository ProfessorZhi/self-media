   "lines": [
    {
     "id": "l1",
     "sub": "先把 AB 放成水平向右",
     "start": 26.485,
     "end": 28.254
    },
    {
     "id": "l2",
     "sub": "AC 就是竖直方向",
     "start": 28.414,
     "end": 30.321
    },
    {
     "id": "l3",
     "sub": "因为两者垂直",
     "start": 30.821,
     "end": 31.985
    },
    {
     "id": "l4",
     "sub": "AD 在 AB 方向上的投影",
     "start": 32.145,
     "end": 34.047
    },
    {
     "id": "l5",
     "sub": "正好是 D 到直线 AC 的有向距离",
     "start": 34.207,
     "end": 36.825
    },
    {
     "id": "l6",
     "sub": "为了让点积最小",
     "start": 37.325,
     "end": 38.493
    },
    {
     "id": "l7",
     "sub": "我们要问的是",
     "start": 38.653,
     "end": 39.418
    },
    {
     "id": "l8",
     "sub": "D 最多能向左偏多远",
     "start": 39.578,
     "end": 41.105
    }
   ],
   "dur": 17.32,
   "end": 43.305
  },
  {
   "id": "c2card",
   "kind": "card",
   "start": 43.305,
   "dur": 3.2,
   "end": 45.805
  },
  {
   "id": "c2",
   "kind": "shot",
   "start": 45.805,
   "lines": [
    {
     "id": "a1",
     "sub": "设 AD 为 a  CD 为 b",
     "start": 46.305,
     "end": 49.254
    },
    {
     "id": "a2",
     "sub": "在三角形 ADC 中用余弦定理",
     "start": 49.414,
     "end": 52.254
    },
    {
     "id": "a3",
     "sub": "a² + b² + ab = 12",
     "start": 52.414,
     "end": 55.166
    },
    {
     "id": "a4",
     "sub": "平方和不小于两倍乘积",
     "start": 55.326,
     "end": 57.179
    },
    {
     "id": "a5",
     "sub": "所以 ab 不超过 4",
     "start": 57.339,
     "end": 59.087
    },
    {
     "id": "a6",
     "sub": "再把三角形 ADC 的面积算两遍",
     "start": 59.587,
     "end": 62.701
    },
    {
     "id": "a7",
     "sub": "用两边夹角  面积是 √3/4 · ab",
     "start": 62.861,
     "end": 66.676
    },
    {
     "id": "a8",
     "sub": "以 AC 为底  面积是 √3 · h",
     "start": 66.836,
     "end": 70.125
    },
    {
     "id": "a9",
     "sub": "所以 h = ab/4  最多是 1",
     "start": 70.285,
     "end": 73.575
    },
    {
     "id": "a10",
     "sub": "D 最多向左偏 1",
     "start": 74.075,
     "end": 75.575
    },
    {
     "id": "a11",
     "sub": "点积最小就是 2 × (−1) = −2",
     "start": 75.735,
     "end": 78.976
    },
    {
     "id": "a12",
     "sub": "a = b = 2 时取等号  这个最小值真的存在",
     "start": 79.136,
     "end": 83.678
    }
   ],
   "dur": 39.473,
   "end": 85.278
  },
  {
   "id": "c3card",
   "kind": "card",
   "start": 85.278,
   "dur": 3.2,
   "end": 87.778
  },
  {
   "id": "c3",
   "kind": "shot",
   "start": 87.778,
   "lines": [
    {
     "id": "b1",
     "sub": "第二种方法更漂亮",
     "start": 88.278,
     "end": 89.58
    },
    {
     "id": "b2",
     "sub": "直角三角形 ABC 中  BC = 4  ∠B = 60°",
     "start": 89.74,
     "end": 95.082
    },
    {
     "id": "b3",
     "sub": "我们只考虑点积为负的情形",
     "start": 95.242,
     "end": 96.868
    },
    {
     "id": "b4",
     "sub": "也就是 D 和 B 分居 AC 两侧",
     "start": 97.028,
     "end": 99.681
    },
    {
     "id": "b5",
     "sub": "60° + 120° 恰好是 180°",
     "start": 100.181,
     "end": 104.298
    },
    {
     "id": "b6",
     "sub": "对角互补  四点共圆",
     "start": 104.458,
     "end": 106.31
    },
    {
     "id": "b7",
     "sub": "又因为 ∠A 是直角  BC 就是这个圆的直径",
     "start": 106.47,
     "end": 110.593
    },
    {
     "id": "b8",
     "sub": "半径是 2",
     "start": 110.753,
     "end": 111.525
    },
    {
     "id": "b9",
     "sub": "圆心是 BC 的中点  横坐标是 1",
     "start": 112.025,
     "end": 114.855
    },
    {
     "id": "b10",
     "sub": "圆上最左的点  横坐标 1 − 2 = −1",
     "start": 115.015,
     "end": 119.093
    },
    {
     "id": "b11",
     "sub": "点积的最小值还是 −2",
     "start": 119.253,
     "end": 121.413
    }
   ],
   "dur": 35.235,
   "end": 123.013
  },
  {
