# Secrets and local settings
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.credentials.json
**/cookies*.json
**/*-session-profile/
**/browser-profile/

# OS, editor, caches
.DS_Store
Thumbs.db
.vscode/
.idea/
**/node_modules/
**/.cache/
**/__pycache__/
*.py[cod]
